rules_version = '2';

// Public menu reads; only the authenticated admin may change the shared menu document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /menu/site {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "45el7lJ5bbP1bVwgFEpBQKyc1wl2";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
