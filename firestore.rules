rules_version = '2';

// Zakho Bistro menu — paste into Firebase Console → Firestore Database → Rules → Publish.
// This is what actually protects the menu: the website is public, the password lives
// only in Firebase Authentication, and only the admin UID below may change data.
service cloud.firestore {
  match /databases/{database}/documents {

    // The single menu document(s): everyone may read, only the admin may write.
    match /menu/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "45el7lJ5bbP1bVwgFEpBQKyc1wl2";
    }

    // Everything else in the database stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
